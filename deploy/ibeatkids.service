[Unit]
Description=ibeatkids (archived gamerboy80 fan site + live API, bend2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# adjust these to your setup
User=CHANGE_ME
WorkingDirectory=/opt/ibeatkids
# Compile once at deploy: bend main.bend -o ibeatkids (clang needed at build
# time). The binary still shells out to curl/sh, keep them on the PATH.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/ibeatkids/ibeatkids -- -addr 127.0.0.1:16711
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
